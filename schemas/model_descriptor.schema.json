{
  "$defs": {
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "family": {
      "enum": [
        "chroma",
        "birefnet",
        "sam2",
        "sam3"
      ],
      "title": "Family",
      "type": "string"
    },
    "license_approved": {
      "title": "License Approved",
      "type": "boolean"
    },
    "license_spdx": {
      "minLength": 1,
      "title": "License Spdx",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "precision": {
      "enum": [
        "uint8",
        "float32",
        "float16",
        "bfloat16"
      ],
      "title": "Precision",
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "supported_devices": {
      "items": {
        "enum": [
          "cpu",
          "mps",
          "cuda"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Supported Devices",
      "type": "array"
    },
    "weights_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "name",
    "family",
    "revision",
    "license_spdx",
    "license_approved",
    "supported_devices",
    "precision"
  ],
  "title": "ModelDescriptor",
  "type": "object"
}
