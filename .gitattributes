# Auto detect text files and perform LF normalization
* text=auto

data/validation/**/*.png filter=lfs diff=lfs merge=lfs -text
data/validation/**/*.jpg filter=lfs diff=lfs merge=lfs -text
data/validation/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
data/validation/**/*.tif filter=lfs diff=lfs merge=lfs -text
data/validation/**/*.tiff filter=lfs diff=lfs merge=lfs -text
